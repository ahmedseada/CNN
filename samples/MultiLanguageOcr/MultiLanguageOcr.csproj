<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MultiLanguageOcr</RootNamespace>
    <!-- One page is read in one run: methods with loops (the pixel work) are compiled optimized at their first call
         instead of starting as quick, unoptimized code. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Idrak" Version="0.3.1" />
    <ProjectReference Include="..\..\src\CnnSamples.Shared\CnnSamples.Shared.csproj" />
  </ItemGroup>

</Project>
